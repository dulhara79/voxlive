# ─── Google Cloud ────────────────────────────────────────────────────────────
# GCP project ID that has Speech-to-Text v2 (Chirp) enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to your service account JSON key (local dev only).
# On Cloud Run / GKE, remove this line — ADC is automatic.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Chirp-supported regional locations (do NOT use 'global' — causes INVALID_ARGUMENT):
#   us-central1       — US (default)
#   europe-west4      — Netherlands
#   asia-southeast1   — Singapore (lowest latency from Sri Lanka)
SPEECH_LOCATION=us-central1

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# CORS: origin(s) allowed to connect (comma-separated for multiple)
ALLOWED_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------------------

# ── VoxLive backend configuration ────────────────────────────────────────────

# Port the backend listens on.
PORT=8080

# Frontend origin allowed to reach the /health endpoint (CORS).
ALLOWED_ORIGIN=http://localhost:5173

# Google Speech-to-Text model.
#   default      → broadest language coverage; safest for Sinhala (si-LK). START HERE.
#   latest_long  → better English/Tamil accuracy. Use ONLY if si-LK still works
#                  for you on this model (test it before switching).
SPEECH_MODEL=default

# Enhanced model variant. Leave false unless your model+languages support it.
USE_ENHANCED=false

# Service-account key for local / non-GCP environments.
# On Cloud Run / GKE, REMOVE this line — Workload Identity (ADC) is automatic.
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json

# ── Notes ────────────────────────────────────────────────────────────────────
# This backend uses Speech-to-Text v1p1beta1 with a STANDARD model (not Chirp),
# because that is the only Google path that supports Sinhala (si-LK) plus
# per-utterance multi-language detection across si-LK / en-US / ta-IN in one
# live stream. No SPEECH_LOCATION / regional endpoint is needed for v1.
